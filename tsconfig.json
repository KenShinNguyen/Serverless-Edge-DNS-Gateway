{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmit": true,
    "noImplicitAny": false,
    "noUnusedLocals": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
